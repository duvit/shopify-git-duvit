<script src="{{ 'color-selector.js' | asset_url }}" defer></script>
{{ 'section-banner-product.css' | asset_url | stylesheet_tag }}

{% assign current_product = product %}
{% if current_product == null and section.settings.product_handle != blank %}
  {% assign current_product = all_products[section.settings.product_handle] %}
{% endif %}

{% if current_product == null %}
  <div style="product-card__error">
    {{
      'sections.product_banner.error_no_product'
      | t: default: 'Не вдалося отримати продукт. Перевірте handle у налаштуваннях.'
    }}
  </div>
{% else %}
  <div class="product-card">
    <div class="product-card__gallery">
      <div class="product-card__main-image">
        {% if current_product.featured_image %}
          <img
            src="{{ current_product.featured_image | image_url: width: 536 }}"
            alt="{{ current_product.featured_image.alt | default: current_product.title }}"
            width="536"
            height="536"
          >
        {% else %}
          <img
            src="{{ 'placeholder-image.png' | asset_url }}"
            alt="{{ current_product.title | default: '-' }}"
            width="536"
            height="536"
          >
        {% endif %}
      </div>
    </div>

    <div class="product-card__info">
      <h2 class="product-card__title">{{ current_product.title | escape | default: '-' }}</h2>

      {% assign first_variant = current_product.variants.first %}
      {% capture price_block %}
        {% if first_variant.compare_at_price > first_variant.price %}
          <span class="price--sale">{{ first_variant.price | money_without_trailing_zeros }}</span>
          <span class="price--compare" style="text-decoration: line-through; color: #888;">
            {{ first_variant.compare_at_price | money_without_trailing_zeros }}
          </span>
        {% else %}
          <span class="price">{{ first_variant.price | money_without_trailing_zeros }}</span>
        {% endif %}
      {% endcapture %}
      <div id="product-price-block" class="product-card__info-price text-base">
        {{ price_block }}
      </div>

      {% if current_product.options_by_name.color %}
        {% assign color_index = null %}
        {% for option in current_product.options_with_values %}
          {% if option.name == 'Color' %}
            {% assign color_index = forloop.index0 %}
          {% endif %}
        {% endfor %}

        {% assign unique_colors = '' %}
        {% for variant in current_product.variants %}
          {% assign color = variant.options[color_index] %}
          {% unless unique_colors contains color %}
            {% assign unique_colors = unique_colors | append: color | append: ',' %}
          {% endunless %}
        {% endfor %}
        {% assign colors = unique_colors | split: ',' | uniq %}

        <div class="color-options">
          {% for color in colors limit: 3 %}
            {% assign total_qty = 0 %}
            {% assign variant_id = '' %}
            {% assign has_stock = false %}

            {% for variant in current_product.variants %}
              {% if variant.options[color_index] == color %}
                {% assign total_qty = total_qty | plus: variant.inventory_quantity %}
                {% if variant.inventory_quantity > 0 %}
                  {% assign has_stock = true %}
                {% endif %}
                {% if variant_id == '' %}
                  {% assign variant_id = variant.id %}
                {% endif %}
              {% endif %}
            {% endfor %}

            {% capture price_html %}
              {% for variant in current_product.variants %}
                {% if variant.id == variant_id %}
                  {% if variant.compare_at_price > variant.price %}
                    <span class="price">{{ variant.price | money_without_trailing_zeros }}</span>
                    <span class="price--compare" style="text-decoration:line-through;color:#888;">
                      {{ variant.compare_at_price | money_without_trailing_zeros }}
                    </span>
                  {% else %}
                    <span class="price">{{ variant.price | money_without_trailing_zeros }}</span>
                  {% endif %}
                {% endif %}
              {% endfor %}
            {% endcapture %}

            <button
              class="color-button"
              data-color="{{ color }}"
              data-stock-text="
                {% if has_stock %}
                  {{ 'sections.product_banner.available'| t: default: 'Доступно:' }} {{total_qty}}
                {% else %}
                  {{ 'sections.product_banner.unavailable' | t: default: 'Недоступно'}}
                {% endif %}
              "
              data-available="{{ has_stock }}"
              data-price-html="{{ price_html | escape }}"
            >
              {{ color }}
            </button>
          {% endfor %}
        </div>

        <div id="stock-info" style="margin-top: 10px; font-weight: bold;"></div>
      {% endif %}

      {% if current_product.options_by_name['Shoe size'] %}
        <h3 class="product-card__info-sizes__title text-body-medium">
          {{ 'sections.product_banner.select_size' | t: default: 'Оберіть розмір:' }}
        </h3>
        <div class="product-card__info-sizes" role="group">
          {% for size in current_product.options_by_name['shoe size'].values %}
            <button class="product-card__size-btn" data-size="{{ size }}">
              {{ size }}
            </button>
          {% endfor %}
        </div>
      {% endif %}

      <button class="button button--dark button--xl add-to-bag-btn" type="button">
        {{ 'sections.product_banner.add_to_bag' | t: default: 'Додати в кошик' }}
      </button>

      <p class="product-card__description">
        {{ current_product.description | default: '' }}
      </p>
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Product Banner",
  "tag": "section",
  "settings": [
    {
      "type": "product",
      "id": "product_handle",
      "label": "Handle продукту (fallback)",
      "info": "Pass the product handle if it is not passed automatically via the product variable."
    }
  ],
  "presets": [
    {
      "name": "Product Banner",
      "category": "Product"
    }
  ]
}
{% endschema %}
